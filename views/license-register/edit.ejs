<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit License Entry</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">

</head>
<body class="body">

<main class="main">
    <section class="section">
        <div class="container edit-container">
            <a class="link-cancel" href="/license-register"><i class="fas fa-times"></i> Cancel</a>

            <h1 class="heading">Edit License Entry</h1>

            <% if (error) { %>
                <div class="error-message"><%= error %></div>
            <% } %>

            <form action="/license-register/<%= item._id %>?_method=PUT" method="POST">
                <label for="nameOfEntity" class="form-label">Name of Entity</label>
                <input
                        type="text"
                        id="nameOfEntity"
                        name="nameOfEntity"
                        required
                        class="form-input"
                        value="<%= item.nameOfEntity %>"
                />

                <label for="licenseNumber" class="form-label">License Number</label>
                <input
                        type="text"
                        id="licenseNumber"
                        name="licenseNumber"
                        required
                        class="form-input"
                        value="<%= item.licenseNumber %>"
                />

                <label for="dateOfIssue" class="form-label">Date of Issue</label>
                <input
                        type="date"
                        id="dateOfIssue"
                        name="dateOfIssue"
                        required
                        class="form-input"
                        value="<%= item.dateOfIssue ? item.dateOfIssue.toISOString().substring(0, 10) : '' %>"
                />

                <label for="website" class="form-label">Website</label>
                <input
                        type="url"
                        id="website"
                        name="website"
                        required
                        class="form-input"
                        value="<%= item.website %>"
                />

                <button type="submit" class="btn-submit"><i class="fas fa-save"></i> Save Changes</button>
            </form>
        </div>
    </section>
</main>

</body>
</html>
