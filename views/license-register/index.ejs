<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>License Register</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
      <link rel="stylesheet" href="./css/styles.css">
</head>

<body class="body">
<main class="main">
    <section class="section">
        <div class="table-container container">
            <h1 class="heading">License Register</h1>

            <div class="actions-header">
                <a class="btn link-back" href="/dashboard"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
                <button class="btn btn-refresh" onclick="window.location.reload()"><i class="fas fa-refresh"></i> Refresh</button>
                <a class="btn btn-new" href="/license-register/new"><i class="fas fa-plus"></i> New License</a>
            </div>

            <% if (items.length === 0) { %>
                <p>No licenses found. <a class="link" href="/license-register/new">Create one now.</a></p>
            <% } else { %>
                <table class="table">
                    <thead>
                    <tr>
                        <th class="table-header">Name of Entity</th>
                        <th class="table-header">License Number</th>
                        <th class="table-header">Date of Issue</th>
                        <th class="table-header">Website</th>
                        <th class="table-header">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% items.forEach(item => { %>
                        <tr>
                            <td class="table-cell" data-label="Name of Entity"><%= item.nameOfEntity %></td>
                            <td class="table-cell" data-label="License Number"><%= item.licenseNumber %></td>
                            <td class="table-cell" data-label="Date of Issue"><%= item.dateOfIssue.toISOString().substring(0,10) %></td>
                            <td class="table-cell" data-label="Website">
                                <a class="link" href="<%= item.website %>" target="_blank"><%= item.website %></a>
                            </td>
                            <td class="table-cell actions" data-label="Actions">
                                <button
                                        class="btn btn-edit"
                                        onclick="window.location.href='/license-register/<%= item._id %>/edit'">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <form
                                        action="/license-register/<%= item._id %>?_method=DELETE"
                                        method="POST"
                                        onsubmit="return confirm('Delete this license entry?');"
                                >
                                    <button type="submit" class="btn btn-delete"><i class="fas fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </section>
</main>
</body>
</html>
